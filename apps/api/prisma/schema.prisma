generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ─── USERS ─────────────────────────────────────────────────

model User {
  userId               String    @id @default(uuid()) @map("user_id")
  phoneNumber          String    @unique @map("phone_number")
  email                String?   @unique
  displayName          String?   @map("display_name")
  kycStatus            KycStatus @default(NONE) @map("kyc_status")
  loyaltyPointsBalance Int       @default(0) @map("loyalty_points_balance")

  smsEnabled   Boolean @default(true) @map("sms_enabled")
  pushEnabled  Boolean @default(true) @map("push_enabled")
  emailEnabled Boolean @default(false) @map("email_enabled")

  spendLimitPeriod   SpendPeriod? @map("spend_limit_period")
  spendLimitCapNgn   Int?         @map("spend_limit_cap_ngn")
  selfExclusionUntil DateTime?    @map("self_exclusion_until")

  bankCode            String? @map("bank_code")
  bankAccountLast4    String? @map("bank_account_last4")
  bankAccountNameHash String? @map("bank_account_name_hash")

  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  tickets              Ticket[]
  paymentTransactions  PaymentTransaction[]
  jackpotAccumulations JackpotAccumulation[]

  @@index([phoneNumber])
  @@index([selfExclusionUntil])
  @@map("users")
}

enum KycStatus {
  NONE
  OTP_VERIFIED
  TIER1_COMPLETE
}

enum SpendPeriod {
  WEEKLY
  MONTHLY
}

// ─── AGENTS ────────────────────────────────────────────────

model Agent {
  agentId                String      @id @default(uuid()) @map("agent_id")
  agentCode              String      @unique @map("agent_code")
  phoneNumber            String      @unique @map("phone_number")
  email                  String?     @unique
  fullName               String      @map("full_name")
  registeredStateCode    String      @map("registered_state_code")
  status                 AgentStatus @default(PENDING_KYC)
  tier                   AgentTier   @default(BRONZE)
  commissionRate         Decimal     @default(0.10) @map("commission_rate") @db.Decimal(5, 4)
  isSuperAgent           Boolean     @default(false) @map("is_super_agent")
  superAgentCode         String?     @map("super_agent_code")
  overrideCommissionRate Decimal?    @map("override_commission_rate") @db.Decimal(5, 4)
  bvnHash                String      @map("bvn_hash")
  trainingCompletedAt    DateTime?   @map("training_completed_at")
  agentAgreementSignedAt DateTime?   @map("agent_agreement_signed_at")
  monthlyTicketCount     Int         @default(0) @map("monthly_ticket_count")
  gracePeriodUsedAt      DateTime?   @map("grace_period_used_at")
  // POS terminal identifier printed on tickets sold at this agent.
  terminalNumber Int? @unique @default(autoincrement()) @map("terminal_number")
  walletBalanceNgn Int @default(0) @map("wallet_balance_ngn")

  bankCode            String? @map("bank_code")
  bankAccountLast4    String? @map("bank_account_last4")
  bankAccountNameHash String? @map("bank_account_name_hash")

  ninHash             String? @map("nin_hash")
  idDocPath           String? @map("id_doc_path")
  idDocType           String? @map("id_doc_type")      // NIN_SLIP | DRIVERS_LICENCE | VOTERS_CARD | PASSPORT
  onboardedByAdminId  String? @map("onboarded_by_admin_id")
  onboardingNote      String? @db.Text @map("onboarding_note")
  suspensionReason    String? @map("suspension_reason")
  suspendedAt         DateTime? @map("suspended_at")

  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  tickets             Ticket[]
  paymentTransactions PaymentTransaction[]
  remittances    Remittance[]
  disbursements  CommissionDisbursement[]
  prizesPaid    PrizeClaim[]

  @@index([agentCode])
  @@index([status, tier])
  @@index([superAgentCode])
  @@map("agents")
}

enum AgentTier {
  BRONZE
  SILVER
  GOLD
}

enum AgentStatus {
  PENDING_KYC
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum AdminTier {
  BASIC
  INTERMEDIATE
  SUPER
  AUDITOR
}

// ─── ADMIN USERS ───────────────────────────────────────────

model AdminUser {
  adminUserId    String    @id @default(uuid()) @map("admin_user_id")
  email          String    @unique
  fullName       String    @map("full_name")
  passwordHash   String    @map("password_hash")
  role           AdminRole
  tier           AdminTier  @default(BASIC)   // ← authority tier (maker-checker)
  isActive       Boolean   @default(true) @map("is_active")
  mfaSecret      String?   @map("mfa_secret")
  mfaEnabled     Boolean   @default(false) @map("mfa_enabled")
  lastLoginAt    DateTime? @map("last_login_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  mfaBackupCodes String[]  @map("mfa_backup_codes")
  mfaEnrolledAt  DateTime? @map("mfa_enrolled_at")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")

  @@map("admin_users")
}

enum AdminRole {
  OPERATOR
  COMPLIANCE_OFFICER
  FINANCE_OFFICER
  SUPPORT_AGENT
}

// ─── AUDIT LOG ─────────────────────────────────────────────

model AuditLog {
  logId        String         @id @default(uuid()) @map("log_id")
  timestamp    DateTime       @default(now())
  severity     AuditSeverity
  actorType    AuditActorType @map("actor_type")
  actorId      String?        @map("actor_id")
  action       String
  resourceType String         @map("resource_type")
  resourceId   String         @map("resource_id")
  metadata     Json
  ipAddress    String?        @map("ip_address")
  userAgent    String?        @map("user_agent")
  signature    String?
  seq Int @unique @default(autoincrement())

  @@index([timestamp])
  @@index([actorType, actorId])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditActorType {
  CUSTOMER
  AGENT
  ADMIN
  ENGINE
  SYSTEM
}

// Periodic integrity roots over the audit log. Each checkpoint hashes every
// entry in its window; altering any row changes the recomputed root and no
// longer matches what was stored. Cheap to produce (nothing on the write
// path) and the root is exactly what gets published for external anchoring.
model AuditCheckpoint {
  checkpointId String   @id @default(uuid()) @map("checkpoint_id")

  windowStart  DateTime @map("window_start")
  windowEnd    DateTime @map("window_end")
  fromSeq      Int      @map("from_seq")
  toSeq        Int      @map("to_seq")
  entryCount   Int      @map("entry_count")

  // SHA-256 over the window's entries, chained to the previous checkpoint's
  // root — so tampering with an old window breaks every root after it too.
  rootHash     String   @map("root_hash")
  previousRootHash String? @map("previous_root_hash")

  createdAt    DateTime @default(now()) @map("created_at")

  @@index([windowEnd])
  @@map("audit_checkpoints")
}

// ─── DRAWS ──────────────────────────────────────────────────

model Draw {
  drawId   String     @id @default(uuid()) @map("draw_id")
  drawCode String     @unique @map("draw_code")
  drawType DrawType   @map("draw_type")
  status   DrawStatus @default(SCHEDULED)

  prizeDescription String  @map("prize_description")
  prizeValueNgn    Int     @map("prize_value_ngn")
  prizeImageUrl    String? @map("prize_image_url")

  ticketPriceNgn Int  @map("ticket_price_ngn")
  ticketQuota    Int? @map("ticket_quota")

  scheduledAt DateTime  @map("scheduled_at")
  cutoffAt    DateTime  @map("cutoff_at")
  executedAt  DateTime? @map("executed_at")

  rescheduledFrom String? @map("rescheduled_from")
  configVersion   Int     @default(1) @map("config_version")
  // Short human reference for the printed ticket and support calls.
  // RD-DRAW-20260728-DAILY is precise but unusable over the phone.
  drawNumber Int @unique @default(autoincrement()) @map("draw_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tickets        Ticket[]
  result         DrawResult?
  seedCommit    DrawSeedCommit?
  jackpotEntries JackpotEntry[]

  @@index([drawType, status])
  @@index([scheduledAt])
  @@index([status, cutoffAt])
  @@map("draws")
}

// Pre-draw seed commitment: the hash is public before the draw runs; the
// seed itself is sealed (AES-256-GCM, engine-only key) until reveal.
model DrawSeedCommit {
  drawId      String   @id @map("draw_id")
  seedHash    String   @map("seed_hash")
  sealedSeed  String   @map("sealed_seed") // base64 iv:ciphertext:authTag
  committedAt DateTime @default(now()) @map("committed_at")

  draw Draw @relation(fields: [drawId], references: [drawId])

  @@map("draw_seed_commits")
}
enum DrawType {
  DAILY_STANDARD
  SATURDAY_JACKPOT
  PRODUCT_PRIZE
}

enum DrawStatus {
  SCHEDULED
  ACTIVE
  SALES_CLOSED
  EXECUTING
  COMPLETED
  POSTPONED
  CANCELLED
}

// ─── PAYMENTS ───────────────────────────────────────────────

model PaymentTransaction {
  txnId String @id @default(uuid()) @map("txn_id")

  gatewayReference String         @unique @map("gateway_reference")
  gateway          PaymentGateway
  amountNgn        Int            @map("amount_ngn")

  buyerPhone  String  @map("buyer_phone")
  buyerUserId String? @map("buyer_user_id")

  channel PurchaseChannel
  agentId String?         @map("agent_id")

  ticketCount Int           @map("ticket_count")
  status      PaymentStatus @default(PENDING)

  confirmedAt    DateTime? @map("confirmed_at")
  failureReason  String?   @map("failure_reason")
  webhookPayload Json?     @map("webhook_payload")
  buyerEmail String? @map("buyer_email")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  buyer   User?    @relation(fields: [buyerUserId], references: [userId])
  agent   Agent?   @relation(fields: [agentId], references: [agentId])
  tickets Ticket[]

  @@index([gateway, status])
  @@index([buyerPhone, createdAt])
  @@index([agentId, createdAt])
  @@map("payment_transactions")
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
  AGENT_CASH
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  DUPLICATE
  REFUNDED
}

enum PurchaseChannel {
  DIRECT
  AGENT
}

// ─── TICKETS ────────────────────────────────────────────────

model Ticket {
  ticketId  String @id @default(uuid()) @map("ticket_id")
  ticketRef String @unique @map("ticket_ref")

  drawId       String     @map("draw_id")
  ticketType   TicketType @map("ticket_type")
  faceValueNgn Int        @map("face_value_ngn")

  buyerPhone  String  @map("buyer_phone")
  buyerUserId String? @map("buyer_user_id")

  agentId         String?         @map("agent_id")
  purchaseChannel PurchaseChannel @map("purchase_channel")
  stateOfPlayCode String          @map("state_of_play_code")

  paymentTxnId String @map("payment_txn_id")

  status   TicketStatus @default(ACTIVE)
  isWinner Boolean      @default(false) @map("is_winner")

  drawResultId   String? @map("draw_result_id")
  rolledToDrawId String? @map("rolled_to_draw_id")

  confirmationSmsSentAt DateTime? @map("confirmation_sms_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  draw    Draw               @relation(fields: [drawId], references: [drawId])
  buyer   User?              @relation(fields: [buyerUserId], references: [userId])
  agent   Agent?             @relation(fields: [agentId], references: [agentId])
  payment PaymentTransaction @relation(fields: [paymentTxnId], references: [txnId])

  @@index([buyerPhone, drawId])
  @@index([drawId, status])
  @@index([agentId, createdAt])
  @@index([ticketRef])
  @@index([paymentTxnId])
  @@map("tickets")
}

enum TicketType {
  STANDARD
  JACKPOT
}

enum TicketStatus {
  ACTIVE
  EXPIRED
  WINNING
  ROLLED_OVER
}

// ─── JACKPOT ACCUMULATION ───────────────────────────────────

model JackpotAccumulation {
  accumId String @id @default(uuid()) @map("accum_id")

  buyerPhone  String  @unique @map("buyer_phone")
  buyerUserId String? @map("buyer_user_id")

  cumulativeCount     Int @default(0) @map("cumulative_count")
  jackpotEntriesTotal Int @default(0) @map("jackpot_entries_total")

  lastTicketAt DateTime @map("last_ticket_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [buyerUserId], references: [userId])

  @@index([buyerUserId])
  @@map("jackpot_accumulations")
}

model JackpotEntry {
  entryId String @id @default(uuid()) @map("entry_id")

  drawId         String             @map("draw_id")
  source         JackpotEntrySource
  sourceTicketId String?            @map("source_ticket_id")
  sourceAccumId  String?            @map("source_accum_id")

  buyerPhone  String  @map("buyer_phone")
  buyerUserId String? @map("buyer_user_id")

  status JackpotEntryStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")

  draw Draw @relation(fields: [drawId], references: [drawId])

  @@index([drawId, status])
  @@index([buyerPhone])
  @@index([buyerUserId])
  @@map("jackpot_entries")
}

enum JackpotEntrySource {
  ACCUMULATION
  DIRECT_PURCHASE
}

enum JackpotEntryStatus {
  ACTIVE
  WINNING
  EXPIRED
}

// ─── DRAW RESULTS ───────────────────────────────────────────

model DrawResult {
  resultId String @id @default(uuid()) @map("result_id")
  drawId   String @unique @map("draw_id")

  winnerTicketRef String @map("winner_ticket_ref")
  prizeValueNgn   Int    @map("prize_value_ngn")

  totalTicketsSold          Int @map("total_tickets_sold")
  totalEligibleParticipants Int @map("total_eligible_participants")

  rngSeedHash     String   @map("rng_seed_hash")
  rngSeed         String   @map("rng_seed")
  rngSeedHashedAt DateTime @map("rng_seed_hashed_at")

  merkleRoot     String @map("merkle_root")
  stateBreakdown Json   @map("state_breakdown")

  zeroInterventionConfirmed Boolean @map("zero_intervention_confirmed")

  engineVersion   String @map("engine_version")
  engineSignature String @map("engine_signature")

  executedAt DateTime @map("executed_at")

  draw Draw @relation(fields: [drawId], references: [drawId])
  claim PrizeClaim?

  @@map("draw_results")
}

// ─── PRIZE CLAIMS ───────────────────────────────────────────

model PrizeClaim {
  claimId             String           @id @default(uuid()) @map("claim_id")
  drawResultId        String           @unique @map("draw_result_id")
  winnerTicketRef     String           @map("winner_ticket_ref")
  winnerPhone         String           @map("winner_phone")
  winnerUserId        String?          @map("winner_user_id")

  claimType           ClaimType?       @map("claim_type")
  claimTypeSelectedAt DateTime?        @map("claim_type_selected_at")
  status              PrizeClaimStatus @default(NOTIFIED)

  grossPrizeValueNgn  Int              @map("gross_prize_value_ngn")
  whtApplicable       Boolean          @default(false) @map("wht_applicable")
  whtAmountNgn        Int              @default(0) @map("wht_amount_ngn")
  netPrizeValueNgn    Int              @map("net_prize_value_ngn")
  whtDeduction WhtDeduction?


  selectionDeadlineAt DateTime         @map("selection_deadline_at")
  claimDeadlineAt     DateTime         @map("claim_deadline_at")
  forfeitedAt         DateTime?        @map("forfeited_at")
  fulfilledAt         DateTime?        @map("fulfilled_at")

  // KYC artefacts (populated in 8.3/8.4)
  kycBvnHash          String?          @map("kyc_bvn_hash")
  kycBvnVerifiedAt    DateTime?        @map("kyc_bvn_verified_at")
  kycBankCode         String?          @map("kyc_bank_code")
  kycBankAccountLast4 String?          @map("kyc_bank_account_last4")
  kycBankAccountName  String?          @map("kyc_bank_account_name")
  kycIdDocPath        String?          @map("kyc_id_doc_path")
  kycSelfiePath       String?          @map("kyc_selfie_path")
  kycReviewedBy       String?          @map("kyc_reviewed_by")
  kycReviewedAt       DateTime?        @map("kyc_reviewed_at")

  // Fulfilment (8.6)
  collectionPointId     String?        @map("collection_point_id")
  collectionScheduledAt DateTime?      @map("collection_scheduled_at")
  payoutReference       String?        @map("payout_reference")
  payoutInitiatedAt     DateTime?      @map("payout_initiated_at")
  payoutAccountNumber   String?        @map("payout_account_number")
  // Set when an agent settles the prize in cash from their own till. Without
  // this the paying agent is only recoverable by parsing payoutReference or
  // reading the audit log — neither is something a cash obligation should
  // depend on.
  paidByAgentId         String?        @map("paid_by_agent_id")
  paidByAgentAt         DateTime?      @map("paid_by_agent_at")

  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  drawResult      DrawResult       @relation(fields: [drawResultId], references: [resultId])
  collectionPoint CollectionPoint? @relation(fields: [collectionPointId], references: [pointId])
  paidByAgent     Agent?           @relation(fields: [paidByAgentId], references: [agentId])

  @@map("prize_claims")
  @@index([winnerPhone])
  @@index([status, selectionDeadlineAt])
  @@index([paidByAgentId, paidByAgentAt])
}

enum ClaimType {
  PRODUCT
  CASH
}

enum PrizeClaimStatus {
  NOTIFIED
  SELECTION_MADE
  KYC_PENDING
  KYC_CLEARED
  PRODUCT_BOOKED
  DELIVERED
  CASH_PAID
  FORFEITED
}

model CollectionPoint {
  pointId   String   @id @default(uuid()) @map("point_id")
  name      String
  stateCode String   @map("state_code")
  address   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  claims PrizeClaim[]

  @@map("collection_points")
  @@index([stateCode, isActive])
}

// ─── AGENT REMITTANCE (agent → Surewina, daily) ─────────────

model Remittance {
  remittanceId     String           @id @default(uuid()) @map("remittance_id")
  agentId          String           @map("agent_id")
  periodDate       DateTime         @map("period_date") @db.Date
  grossSalesNgn    Int              @map("gross_sales_ngn")
  commissionNgn    Int              @map("commission_ngn")
  amountDueNgn     Int              @map("amount_due_ngn") // net: gross less commission and winnings paid out
  ticketCount      Int              @map("ticket_count")

  // Ticket mix. Snapshotted rather than derived on read: a ticket voided in
  // March must not change what January's record says was sold.
  standardTicketCount Int @default(0) @map("standard_ticket_count")
  jackpotTicketCount  Int @default(0) @map("jackpot_ticket_count")
  standardSalesNgn    Int @default(0) @map("standard_sales_ngn")
  jackpotSalesNgn     Int @default(0) @map("jackpot_sales_ngn")

  //Prizes the agent paid winners from their own till, which reduces what they owe as Sources from PrizeClaim.paidByAgentId
  winningsPaidOutNgn  Int @default(0) @map("winnings_paid_out_ngn")

  status           RemittanceStatus @default(PENDING)
  bankTransferRef  String?          @map("bank_transfer_ref")
  agentConfirmedAt DateTime?        @map("agent_confirmed_at")
  deadlineWarnedAt DateTime?        @map("deadline_warned_at")
  receivedAt       DateTime?        @map("received_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [agentId])

  @@unique([agentId, periodDate])
  @@index([status, periodDate])
  @@map("remittances")
}

enum RemittanceStatus {
  PENDING
  AGENT_CONFIRMED
  RECEIVED
  LATE
  WRITTEN_OFF
  CREDITED_TO_WALLET
}

// ─── COMMISSION DISBURSEMENT (Surewina → agent, daily) ──────

model CommissionDisbursement {
  disbId          String     @id @default(uuid()) @map("disb_id")
  agentId         String     @map("agent_id")
  periodDate      DateTime   @map("period_date") @db.Date
  amountNgn       Int        @map("amount_ngn")
  ticketCount     Int        @map("ticket_count")
  status          DisbStatus @default(PENDING)
  payoutReference String?    @map("payout_reference")
  initiatedAt     DateTime?  @map("initiated_at")
  createdAt       DateTime   @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [agentId])

  @@unique([agentId, periodDate])
  @@map("commission_disbursements")
}

enum DisbStatus {
  PENDING
  INITIATED
  SETTLED
  FAILED
}

// Admin-imposed purchase blocks, keyed by phone because buyers are
// phone-first and may have no User row. Checked at every purchase door.
model BlockedPhone {
  phoneNumber String   @id @map("phone_number")
  reason      String
  blockedBy   String   @map("blocked_by") // adminUserId
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("blocked_phones")
}

enum ConfigVersionStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUPERSEDED
  REJECTED
}

enum DrawTemplateType {
  DAILY_STANDARD
  SATURDAY_JACKPOT
}

// Versioned recurring-draw configuration. The scheduler resolves the ACTIVE
// version whose effective window covers "now". Changes are proposed by one
// admin and approved by another (maker-checker), never edited in place.
model DrawTemplate {
  templateId   String            @id @default(uuid()) @map("template_id")
  templateType DrawTemplateType  @map("template_type")

  // Human label, e.g. "Daily draw — standard pricing"
  label        String

  // What the scheduler stamps onto created draws
  prizeDescription String @map("prize_description")
  prizeValueNgn    Int    @map("prize_value_ngn")
  ticketPriceNgn   Int    @map("ticket_price_ngn")
  ticketQuota      Int?   @map("ticket_quota")

  // WAT wall-clock times, stored as minutes past midnight (0–1439)
  cutoffMinutesWat    Int @map("cutoff_minutes_wat")
  scheduledMinutesWat Int @map("scheduled_minutes_wat")

  // Which WAT weekdays this template applies to (0=Sun … 6=Sat)
  weekdays Int[] @map("weekdays")

  // Version lifecycle
  version       Int                 @default(1)
  status        ConfigVersionStatus @default(DRAFT)
  effectiveFrom DateTime            @map("effective_from")
  effectiveTo   DateTime?           @map("effective_to")

  // Maker-checker trail
  createdByAdminId  String    @map("created_by_admin_id")
  approvedByAdminId String?   @map("approved_by_admin_id")
  approvedAt        DateTime? @map("approved_at")
  rejectionNote     String?   @map("rejection_note")

  // Links a new version back to the one it replaces
  supersedesId String?        @unique @map("supersedes_id")
  supersedes   DrawTemplate?  @relation("TemplateVersions", fields: [supersedesId], references: [templateId])
  supersededBy DrawTemplate?  @relation("TemplateVersions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([templateType, status, effectiveFrom])
  @@map("draw_templates")
}

// Immutable record of WHT withheld from a fulfilled prize. These rows feed
// the periodic remittance schedule filed with the tax authority — the
// authority issues any credit note to the winner, not us.
model WhtDeduction {
  deductionSeq Int    @id @default(autoincrement()) @map("deduction_seq")
  deductionRef String @unique @map("deduction_ref")
  claimId      String @unique @map("claim_id")
  claim        PrizeClaim @relation(fields: [claimId], references: [claimId])

  winnerTicketRef String  @map("winner_ticket_ref")
  winnerPhone     String  @map("winner_phone")
  grossPrizeNgn   Int     @map("gross_prize_ngn")
  whtRatePercent  Decimal @map("wht_rate_percent") @db.Decimal(5, 2)
  whtAmountNgn    Int     @map("wht_amount_ngn")
  netPrizeNgn     Int     @map("net_prize_ngn")

  deductedAt DateTime @default(now()) @map("deducted_at")

  @@index([deductedAt])
  @@map("wht_deductions")
}

// Scalar business settings, editable in admin instead of redeploying.
// Values are strings; the service parses. Every change is CRITICAL-audited.
model SystemSetting {
  key         String   @id
  value       String
  description String
  updatedByAdminId String?  @map("updated_by_admin_id")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  ESCALATED
  RESOLVED
  REJECTED
}

enum DisputeCategory {
  PAYMENT_NO_TICKET      // debited but no ticket issued
  PRIZE_NOT_RECEIVED     // won but prize not delivered/paid
  AGENT_CASH_ISSUE       // paid agent cash, no ticket / dispute over agent payout
  RESULT_CONTESTED       // disputes a draw outcome
  ACCOUNT_ACCESS         // can't access account / claim
  OTHER
}

enum DisputeRaisedByType {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum DisputeEventType {
  CREATED
  STATUS_CHANGED
  NOTE_ADDED
  ASSIGNED
  RESOLUTION_RECORDED
}

model Dispute {
  disputeId   String   @id @default(uuid()) @map("dispute_id")
  disputeRef  String   @unique @map("dispute_ref")   // DSP-YYYY-NNNNNN
  disputeSeq  Int      @unique @default(autoincrement()) @map("dispute_seq")

  category    DisputeCategory
  status      DisputeStatus @default(OPEN)

  // Who it's about / from — phone is the customer anchor (matches your auth)
  raisedByType DisputeRaisedByType @map("raised_by_type")
  raisedByAdminId String?          @map("raised_by_admin_id")
  customerPhone   String           @map("customer_phone")

  subject     String   @db.Text          // customer's own words / summary
  // Optional links to the thing in dispute (any may be null)
  ticketRef   String?  @map("ticket_ref")
  paymentTxnId String? @map("payment_txn_id")
  claimId     String?  @map("claim_id")
  agentCode   String?  @map("agent_code")

  assignedToAdminId String?   @map("assigned_to_admin_id")
  resolutionNote    String?   @db.Text @map("resolution_note")
  resolvedByAdminId String?   @map("resolved_by_admin_id")
  resolvedAt        DateTime? @map("resolved_at")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  events      DisputeEvent[]

  @@index([status, createdAt])
  @@index([customerPhone])
  @@map("disputes")
}

// Append-only timeline. Never updated or deleted — the case history.
model DisputeEvent {
  eventId     String   @id @default(uuid()) @map("event_id")
  disputeId   String   @map("dispute_id")
  dispute     Dispute  @relation(fields: [disputeId], references: [disputeId])

  type        DisputeEventType
  // Actor: admin id, or 'CUSTOMER:<phone>', or 'SYSTEM'
  actorType   DisputeRaisedByType @map("actor_type")
  actorId     String              @map("actor_id")

  note        String?  @db.Text          // note text or status-change detail
  fromStatus  DisputeStatus? @map("from_status")
  toStatus    DisputeStatus? @map("to_status")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([disputeId, createdAt])
  @@map("dispute_events")
}