generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ─────────────────────────────────────────────────

model User {
  userId               String    @id @default(uuid()) @map("user_id")
  phoneNumber          String    @unique @map("phone_number")
  email                String?   @unique
  displayName          String?   @map("display_name")
  kycStatus            KycStatus @default(NONE) @map("kyc_status")
  loyaltyPointsBalance Int       @default(0) @map("loyalty_points_balance")

  smsEnabled   Boolean @default(true) @map("sms_enabled")
  pushEnabled  Boolean @default(true) @map("push_enabled")
  emailEnabled Boolean @default(false) @map("email_enabled")

  spendLimitPeriod   SpendPeriod? @map("spend_limit_period")
  spendLimitCapNgn   Int?         @map("spend_limit_cap_ngn")
  selfExclusionUntil DateTime?    @map("self_exclusion_until")

  bankCode            String? @map("bank_code")
  bankAccountLast4    String? @map("bank_account_last4")
  bankAccountNameHash String? @map("bank_account_name_hash")

  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  tickets              Ticket[]
  paymentTransactions  PaymentTransaction[]
  jackpotAccumulations JackpotAccumulation[]
  wallet               Wallet?               @relation("CustomerWallet")
  walletPurchases      WalletPurchase[]

  @@index([phoneNumber])
  @@index([selfExclusionUntil])
  @@map("users")
}

enum KycStatus {
  NONE
  OTP_VERIFIED
  TIER1_COMPLETE
}

enum SpendPeriod {
  WEEKLY
  MONTHLY
}

// ─── AGENTS ────────────────────────────────────────────────

model Agent {
  agentId                String      @id @default(uuid()) @map("agent_id")
  agentCode              String      @unique @map("agent_code")
  phoneNumber            String      @unique @map("phone_number")
  email                  String?     @unique
  fullName               String      @map("full_name")
  registeredStateCode    String      @map("registered_state_code")
  status                 AgentStatus @default(PENDING_KYC)
  tier                   AgentTier   @default(BRONZE)
  commissionRate         Decimal     @default(0.10) @map("commission_rate") @db.Decimal(5, 4)
  isSuperAgent           Boolean     @default(false) @map("is_super_agent")
  superAgentCode         String?     @map("super_agent_code")
  overrideCommissionRate Decimal?    @map("override_commission_rate") @db.Decimal(5, 4)
  bvnHash                String      @map("bvn_hash")
  trainingCompletedAt    DateTime?   @map("training_completed_at")
  agentAgreementSignedAt DateTime?   @map("agent_agreement_signed_at")
  monthlyTicketCount     Int         @default(0) @map("monthly_ticket_count")
  gracePeriodUsedAt      DateTime?   @map("grace_period_used_at")
  // POS terminal identifier printed on tickets sold at this agent.
  terminalNumber         Int?        @unique @default(autoincrement()) @map("terminal_number")
  walletBalanceNgn       Int         @default(0) @map("wallet_balance_ngn")

  bankCode            String? @map("bank_code")
  bankAccountLast4    String? @map("bank_account_last4")
  bankAccountNameHash String? @map("bank_account_name_hash")

  wallet Wallet? @relation("AgentWallet")

  ninHash            String?   @map("nin_hash")
  idDocPath          String?   @map("id_doc_path")
  idDocType          String?   @map("id_doc_type") // NIN_SLIP | DRIVERS_LICENCE | VOTERS_CARD | PASSPORT
  onboardedByAdminId String?   @map("onboarded_by_admin_id")
  onboardingNote     String?   @map("onboarding_note") @db.Text
  suspensionReason   String?   @map("suspension_reason")
  suspendedAt        DateTime? @map("suspended_at")

  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  tickets             Ticket[]
  paymentTransactions PaymentTransaction[]
  remittances         Remittance[]
  disbursements       CommissionDisbursement[]
  prizesPaid          PrizeClaim[]

  @@index([agentCode])
  @@index([status, tier])
  @@index([superAgentCode])
  @@map("agents")
}

enum AgentTier {
  BRONZE
  SILVER
  GOLD
}

enum AgentStatus {
  PENDING_KYC
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum AdminTier {
  BASIC
  INTERMEDIATE
  SUPER
  AUDITOR
}

// ─── ADMIN USERS ───────────────────────────────────────────

model AdminUser {
  adminUserId        String    @id @default(uuid()) @map("admin_user_id")
  email              String    @unique
  fullName           String    @map("full_name")
  passwordHash       String    @map("password_hash")
  role               AdminRole
  tier               AdminTier @default(BASIC) // ← authority tier (maker-checker)
  isActive           Boolean   @default(true) @map("is_active")
  mfaSecret          String?   @map("mfa_secret")
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  lastLoginAt        DateTime? @map("last_login_at")
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until")
  createdAt          DateTime  @default(now()) @map("created_at")
  mfaBackupCodes     String[]  @map("mfa_backup_codes")
  mfaEnrolledAt      DateTime? @map("mfa_enrolled_at")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  collectionPointId  String?   @map("collection_point_id")

  @@map("admin_users")
}

enum AdminRole {
  OPERATOR
  COMPLIANCE_OFFICER
  FINANCE_OFFICER
  SUPPORT_AGENT
}

// ─── AUDIT LOG ─────────────────────────────────────────────

model AuditLog {
  logId        String         @id @default(uuid()) @map("log_id")
  timestamp    DateTime       @default(now())
  severity     AuditSeverity
  actorType    AuditActorType @map("actor_type")
  actorId      String?        @map("actor_id")
  action       String
  resourceType String         @map("resource_type")
  resourceId   String         @map("resource_id")
  metadata     Json
  ipAddress    String?        @map("ip_address")
  userAgent    String?        @map("user_agent")
  signature    String?
  seq          Int            @unique @default(autoincrement())

  @@index([timestamp])
  @@index([actorType, actorId])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditActorType {
  CUSTOMER
  AGENT
  ADMIN
  ENGINE
  SYSTEM
}

// Periodic integrity roots over the audit log. Each checkpoint hashes every
// entry in its window; altering any row changes the recomputed root and no
// longer matches what was stored. Cheap to produce (nothing on the write
// path) and the root is exactly what gets published for external anchoring.
model AuditCheckpoint {
  checkpointId String @id @default(uuid()) @map("checkpoint_id")

  windowStart DateTime @map("window_start")
  windowEnd   DateTime @map("window_end")
  fromSeq     Int      @map("from_seq")
  toSeq       Int      @map("to_seq")
  entryCount  Int      @map("entry_count")

  // SHA-256 over the window's entries, chained to the previous checkpoint's
  // root — so tampering with an old window breaks every root after it too.
  rootHash         String  @map("root_hash")
  previousRootHash String? @map("previous_root_hash")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([windowEnd])
  @@map("audit_checkpoints")
}

// ─── DRAWS ──────────────────────────────────────────────────

model Draw {
  drawId   String     @id @default(uuid()) @map("draw_id")
  drawCode String     @unique @map("draw_code")
  drawType DrawType   @map("draw_type")
  status   DrawStatus @default(SCHEDULED)

  prizeDescription String  @map("prize_description")
  prizeValueNgn    Int     @map("prize_value_ngn")
  prizeImageUrl    String? @map("prize_image_url")

  ticketPriceNgn Int  @map("ticket_price_ngn")
  ticketQuota    Int? @map("ticket_quota")

  scheduledAt DateTime  @map("scheduled_at")
  cutoffAt    DateTime  @map("cutoff_at")
  executedAt  DateTime? @map("executed_at")

  rescheduledFrom String?          @map("rescheduled_from")
  configVersion   Int              @default(1) @map("config_version")
  // Short human reference for the printed ticket and support calls.
  // RD-DRAW-20260728-DAILY is precise but unusable over the phone.
  drawNumber      Int              @unique @default(autoincrement()) @map("draw_number")
  walletPurchases WalletPurchase[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tickets              Ticket[]
  result               DrawResult?
  seedCommit           DrawSeedCommit?
  jackpotEntries       JackpotEntry[]
  purchaseTransactions PaymentTransaction[] @relation("PaymentPurchaseDraw")

  @@index([drawType, status])
  @@index([scheduledAt])
  @@index([status, cutoffAt])
  @@map("draws")
}

// Pre-draw seed commitment: the hash is public before the draw runs; the
// seed itself is sealed (AES-256-GCM, engine-only key) until reveal.
model DrawSeedCommit {
  drawId      String   @id @map("draw_id")
  seedHash    String   @map("seed_hash")
  sealedSeed  String   @map("sealed_seed") // base64 iv:ciphertext:authTag
  committedAt DateTime @default(now()) @map("committed_at")

  draw Draw @relation(fields: [drawId], references: [drawId])

  @@map("draw_seed_commits")
}

enum DrawType {
  DAILY_STANDARD
  SATURDAY_JACKPOT
  PRODUCT_PRIZE
}

enum DrawStatus {
  SCHEDULED
  ACTIVE
  SALES_CLOSED
  EXECUTING
  COMPLETED
  POSTPONED
  CANCELLED
}

// ─── PAYMENTS ───────────────────────────────────────────────

model PaymentTransaction {
  txnId String @id @default(uuid()) @map("txn_id")

  gatewayReference String         @unique @map("gateway_reference")
  gateway          PaymentGateway
  amountNgn        Int            @map("amount_ngn")

  buyerPhone  String  @map("buyer_phone")
  buyerUserId String? @map("buyer_user_id")

  channel PurchaseChannel
  agentId String?         @map("agent_id")

  ticketCount Int           @map("ticket_count")
  status      PaymentStatus @default(PENDING)

  confirmedAt    DateTime? @map("confirmed_at")
  failureReason  String?   @map("failure_reason")
  webhookPayload Json?     @map("webhook_payload")
  buyerEmail     String?   @map("buyer_email")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  buyer   User?    @relation(fields: [buyerUserId], references: [userId])
  agent   Agent?   @relation(fields: [agentId], references: [agentId])
  tickets Ticket[]

  // The draw this purchase was created for.
  //
  // This is the internal source of truth for fulfilment.
  // Provider/webhook metadata must never decide which draw receives tickets.
  purchaseDrawId String? @map("purchase_draw_id")

  purchaseDraw   Draw?     @relation("PaymentPurchaseDraw", fields: [purchaseDrawId], references: [drawId])
  providerPaidAt DateTime? @map("provider_paid_at")

  providerTransactionId String? @map("provider_transaction_id")

  refundStatus             PaymentRefundStatus? @map("refund_status")
  refundProvider           PaymentGateway?      @map("refund_provider")
  refundReference          String?              @map("refund_reference")
  refundIdempotencyKey     String?              @unique @map("refund_idempotency_key")
  refundReason             String?              @map("refund_reason")
  refundRequestedByAdminId String?              @map("refund_requested_by_admin_id")
  refundRequestedAt        DateTime?            @map("refund_requested_at")
  refundCompletedAt        DateTime?            @map("refund_completed_at")
  refundLastCheckedAt      DateTime?            @map("refund_last_checked_at")
  refundFailureReason      String?              @map("refund_failure_reason")

  // Phase 7: immutable accounting links for externally received/refunded money.
  collectionLedgerTxnId       String? @unique @map("collection_ledger_txn_id")
  refundAccrualLedgerTxnId    String? @unique @map("refund_accrual_ledger_txn_id")
  refundSettlementLedgerTxnId String? @unique @map("refund_settlement_ledger_txn_id")

  collectionLedgerTxn LedgerTransaction? @relation("PaymentCollectionLedger", fields: [collectionLedgerTxnId], references: [ledgerTxnId], onDelete: Restrict)

  refundAccrualLedgerTxn LedgerTransaction? @relation("PaymentRefundAccrualLedger", fields: [refundAccrualLedgerTxnId], references: [ledgerTxnId], onDelete: Restrict)

  refundSettlementLedgerTxn LedgerTransaction? @relation("PaymentRefundSettlementLedger", fields: [refundSettlementLedgerTxnId], references: [ledgerTxnId], onDelete: Restrict)

  treasurySettlementLines TreasurySettlementLine[]

  @@index([gateway, status])
  @@index([buyerPhone, createdAt])
  @@index([agentId, createdAt])
  @@index([purchaseDrawId])
  @@index([gateway, providerTransactionId])
  @@index([refundStatus, refundRequestedAt])
  @@map("payment_transactions")
}

enum PaymentGateway {
  // Legacy only. New customer collections use MONNIFY or FLUTTERWAVE.
  PAYSTACK
  MONNIFY
  FLUTTERWAVE
  AGENT_CASH
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REVIEW_REQUIRED
  REFUND_PENDING
  FAILED
  DUPLICATE
  REFUNDED
}

enum PurchaseChannel {
  DIRECT
  AGENT
}

enum PaymentRefundStatus {
  REQUESTED
  SUBMITTED
  PROCESSING
  NEEDS_ATTENTION
  SUCCEEDED
  FAILED
  UNKNOWN
}

// ─── DOUBLE-ENTRY LEDGER ───────────────────────────────────
//
// The ledger is append-only.
//
// Posted transactions and entries are never edited or deleted.
// Corrections are represented by new REVERSAL transactions.
//
// Wallets introduced later sit on top of these accounts.
// The ledger itself is the accounting source of truth.

model LedgerAccount {
  accountId String @id @default(uuid()) @map("account_id")

  // Deterministic human-readable identifier.
  //
  // Examples:
  // SYS:PSP:PAYSTACK
  // SYS:BANK:CASH
  // CUSTOMER:<userId>:AVAILABLE
  code String @unique @db.VarChar(180)

  name String @db.VarChar(180)

  accountType LedgerAccountType    @map("account_type")
  purpose     LedgerAccountPurpose

  ownerType LedgerOwnerType @default(SYSTEM) @map("owner_type")

  // Null for platform/system accounts.
  //
  // Customer and agent accounts introduced in Phase 3
  // will carry their userId/agentId here.
  ownerId String? @map("owner_id")

  currency String @default("NGN") @db.VarChar(3)

  status LedgerAccountStatus @default(ACTIVE)

  availableForWallet Wallet? @relation("WalletAvailableAccount")
  heldForWallet      Wallet? @relation("WalletHeldAccount")

  treasuryAccount TreasuryAccount? @relation("TreasuryAccountLedger")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries LedgerEntry[]

  @@index([ownerType, ownerId])
  @@index([purpose, currency])
  @@index([status])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  ledgerTxnId String @id @default(uuid()) @map("ledger_txn_id")

  idempotencyKey String                @unique @map("idempotency_key") @db.VarChar(200)
  kind           LedgerTransactionKind

  referenceType String @map("reference_type") @db.VarChar(100)
  referenceId   String @map("reference_id") @db.VarChar(180)

  description String? @db.Text
  currency    String  @default("NGN") @db.VarChar(3)

  totalAmountNgn Int    @map("total_amount_ngn")
  entryCount     Int    @map("entry_count")
  fingerprint    String @db.Char(64)

  metadata   Json?
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  reversesLedgerTxnId String? @unique @map("reverses_ledger_txn_id")

  walletFunding WalletFunding? @relation("WalletFundingLedger")

  reverses   LedgerTransaction? @relation("LedgerReversal", fields: [reversesLedgerTxnId], references: [ledgerTxnId], onDelete: Restrict)
  reversedBy LedgerTransaction? @relation("LedgerReversal")

  createdWalletHold  WalletHold? @relation("WalletHoldCreated")
  releasedWalletHold WalletHold? @relation("WalletHoldReleased")
  capturedWalletHold WalletHold? @relation("WalletHoldCaptured")
  prizeAccrualClaim  PrizeClaim? @relation("PrizeClaimAccrualLedger")

  prizePayoutAttempt PrizePayoutAttempt? @relation("PrizePayoutLedger")

  prizePayoutReversalAttempt PrizePayoutAttempt? @relation("PrizePayoutReversalLedger")
  agentPayoutClaim            PrizeClaim?         @relation("PrizeClaimAgentPayoutLedger")

  remittanceCommission   Remittance? @relation("RemittanceCommissionLedger")
  remittanceSettlement   Remittance? @relation("RemittanceSettlementLedger")
  remittanceWalletCredit Remittance? @relation("RemittanceWalletCreditLedger")

  collectionPayment       PaymentTransaction? @relation("PaymentCollectionLedger")
  refundAccrualPayment    PaymentTransaction? @relation("PaymentRefundAccrualLedger")
  refundSettlementPayment PaymentTransaction? @relation("PaymentRefundSettlementLedger")
  treasurySettlement      TreasurySettlement? @relation("TreasurySettlementLedger")

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([kind, occurredAt])
  @@index([createdAt])
  @@map("ledger_transactions")
}

model WalletFunding {
  fundingId String @id @default(uuid()) @map("funding_id")
  walletId  String @map("wallet_id")

  gatewayReference String         @unique @map("gateway_reference")
  gateway          PaymentGateway

  amountNgn Int    @map("amount_ngn")
  currency  String @default("NGN") @db.VarChar(3)

  status WalletFundingStatus @default(PENDING)

  providerTransactionId String? @map("provider_transaction_id")

  ledgerTxnId String? @unique @map("ledger_txn_id")

  failureReason       String? @map("failure_reason")
  verificationPayload Json?   @map("verification_payload")

  initiatedAt    DateTime  @default(now()) @map("initiated_at")
  lastVerifiedAt DateTime? @map("last_verified_at")
  creditedAt     DateTime? @map("credited_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wallet Wallet @relation(fields: [walletId], references: [walletId], onDelete: Restrict)

  ledgerTransaction LedgerTransaction? @relation("WalletFundingLedger", fields: [ledgerTxnId], references: [ledgerTxnId], onDelete: Restrict)

  treasurySettlementLines TreasurySettlementLine[]

  @@unique([gateway, providerTransactionId])
  @@index([walletId, createdAt])
  @@index([gateway, status])
  @@index([status, createdAt])
  @@map("wallet_fundings")
}

enum WalletFundingStatus {
  PENDING
  PROCESSING
  CREDITED
  REVIEW_REQUIRED
  FAILED
}

model LedgerEntry {
  entryId String @id @default(uuid()) @map("entry_id")

  ledgerTxnId String @map("ledger_txn_id")
  accountId   String @map("account_id")

  lineNo Int @map("line_no")

  side LedgerEntrySide

  /**
   * Always positive.
   * Direction is represented by side = DEBIT/CREDIT.
   */
  amountNgn Int @map("amount_ngn")

  memo String? @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at")

  transaction LedgerTransaction @relation(fields: [ledgerTxnId], references: [ledgerTxnId], onDelete: Restrict)

  account LedgerAccount @relation(fields: [accountId], references: [accountId], onDelete: Restrict)

  @@unique([ledgerTxnId, lineNo])
  @@index([accountId, createdAt])
  @@index([ledgerTxnId])
  @@map("ledger_entries")
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerOwnerType {
  SYSTEM
  CUSTOMER
  AGENT
}

enum LedgerAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerAccountPurpose {
  PSP_CLEARING
  PAYOUT_CLEARING
  BANK_CASH

  CUSTOMER_AVAILABLE
  CUSTOMER_HELD

  AGENT_AVAILABLE
  AGENT_HELD
  AGENT_RECEIVABLE

  TICKET_SALES_REVENUE

  PRIZE_EXPENSE
  PRIZE_PAYABLE

  TAX_WHT_PAYABLE

  REFUND_PAYABLE

  AGENT_COMMISSION_EXPENSE
  AGENT_RECEIVABLE
  PAYMENT_PROCESSING_FEES
  PROVIDER_ADJUSTMENT_EXPENSE

  SUSPENSE
}

enum LedgerEntrySide {
  DEBIT
  CREDIT
}

enum LedgerTransactionKind {
  OPENING_BALANCE

  FUNDING
  PURCHASE
  PROVIDER_COLLECTION
  PROVIDER_SETTLEMENT

  PRIZE_ACCRUAL
  PRIZE_PAYOUT

  REFUND
  REFUND_ACCRUAL
  REFUND_SETTLEMENT

  AGENT_SALE
  AGENT_REMITTANCE
  COMMISSION

  TRANSFER
  TREASURY_TRANSFER
  ADJUSTMENT

  REVERSAL

  WALLET_HOLD
  WALLET_RELEASE
  WALLET_CAPTURE
}

// ─── PHASE 8 FINANCIAL MIGRATION CONTROL ─────────────────────

enum FinancialMigrationKind {
  AGENT_WALLET_BALANCE
  PAYMENT_COLLECTION
  WALLET_FUNDING
  PAYMENT_REFUND
  PRIZE_ACCRUAL
  AGENT_PRIZE_PAYOUT
  REMITTANCE_ACCOUNTING
  PRIZE_PAYOUT_HISTORY
}

enum FinancialMigrationRunStatus {
  PLANNED
  RUNNING
  COMPLETED
  COMPLETED_WITH_EXCEPTIONS
  FAILED
  FINALIZED
}

enum FinancialMigrationItemStatus {
  PENDING
  APPLIED
  SKIPPED
  REVIEW_REQUIRED
  FAILED
}

model FinancialMigrationRun {
  runId String @id @default(uuid()) @map("run_id")

  label String @db.VarChar(160)

  status FinancialMigrationRunStatus @default(PLANNED)

  createdBy String? @map("created_by") @db.VarChar(120)

  // Records before this instant are legacy migration candidates.
  // New operational recovery services must not rewrite that history.
  cutoverAt DateTime @map("cutover_at")

  plannedCount Int @default(0) @map("planned_count")
  appliedCount Int @default(0) @map("applied_count")
  skippedCount Int @default(0) @map("skipped_count")
  reviewCount  Int @default(0) @map("review_count")
  failedCount  Int @default(0) @map("failed_count")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  finalizedAt DateTime? @map("finalized_at")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items FinancialMigrationItem[]

  @@index([status, createdAt])
  @@map("financial_migration_runs")
}

model FinancialMigrationItem {
  itemId String @id @default(uuid()) @map("item_id")

  runId String @map("run_id")

  kind FinancialMigrationKind

  sourceType String @map("source_type") @db.VarChar(100)
  sourceId   String @map("source_id") @db.VarChar(180)

  status FinancialMigrationItemStatus @default(PENDING)

  snapshot Json?
  result   Json?

  ledgerTxnId String? @map("ledger_txn_id") @db.VarChar(180)

  errorMessage String? @map("error_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  run FinancialMigrationRun @relation(fields: [runId], references: [runId], onDelete: Restrict)

  @@unique([runId, kind, sourceType, sourceId])
  @@index([runId, status])
  @@index([kind, status])
  @@index([sourceType, sourceId])
  @@map("financial_migration_items")
}

// ─── TREASURY & RECONCILIATION ──────────────────────────────

enum TreasuryProvider {
  FLUTTERWAVE
  MONNIFY
  BANK
}

enum TreasuryAccountKind {
  COLLECTION_CLEARING
  PAYOUT_WALLET
  BANK_ACCOUNT
}

enum TreasuryAccountStatus {
  ACTIVE
  DISABLED
}

enum TreasurySettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  FLAGGED
  UNKNOWN
}

enum ReconciliationRunType {
  TRANSACTION
  SETTLEMENT
  BALANCE
  FULL
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_EXCEPTIONS
  FAILED
}

enum ReconciliationIssueType {
  MISSING_INTERNAL
  MISSING_EXTERNAL
  UNMAPPED_REFERENCE
  DUPLICATE_EXTERNAL
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  STATUS_MISMATCH
  FEE_MISMATCH
  SETTLEMENT_SHORTFALL
  BALANCE_VARIANCE
}

