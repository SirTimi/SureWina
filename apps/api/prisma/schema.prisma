// ─── JACKPOT ACCUMULATION ───────────────────────────────────

model JackpotAccumulation {
  accumId String @id @default(uuid()) @map("accum_id")

  buyerPhone  String  @unique @map("buyer_phone")
  buyerUserId String? @map("buyer_user_id")

  // Progress toward the current playing week's jackpot. Ten daily tickets
  // must fall inside one week to earn an entry, so this resets when a
  // purchase lands in a new cycle rather than accumulating for ever.
  cumulativeCount     Int @default(0) @map("cumulative_count")
  jackpotEntriesTotal Int @default(0) @map("jackpot_entries_total")

  // Which Saturday jackpot the counts above belong to. Null on rows created
  // before weekly cycles existed — treated as a spent cycle, so the next
  // purchase starts a clean week.
  cycleDrawId String? @map("cycle_draw_id")

  // Never resets. The weekly counters are for the promotion; these are for
  // reporting, which would otherwise collapse to zero every Saturday.
  lifetimeTicketCount  Int @default(0) @map("lifetime_ticket_count")
  lifetimeEntriesTotal Int @default(0) @map("lifetime_entries_total")

  lastTicketAt DateTime @map("last_ticket_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [buyerUserId], references: [userId])

  @@index([buyerUserId])
  @@map("jackpot_accumulations")
}

model JackpotEntry {
  entryId String @id @default(uuid()) @map("entry_id")

  drawId         String             @map("draw_id")
  source         JackpotEntrySource
  sourceTicketId String?            @map("source_ticket_id")
  sourceAccumId  String?            @map("source_accum_id")

  buyerPhone  String  @map("buyer_phone")
  buyerUserId String? @map("buyer_user_id")

  status JackpotEntryStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")

  draw Draw @relation(fields: [drawId], references: [drawId])

  @@index([drawId, status])
  @@index([buyerPhone])
  @@index([buyerUserId])
  @@map("jackpot_entries")
}

enum JackpotEntrySource {
  ACCUMULATION
  DIRECT_PURCHASE
}

enum JackpotEntryStatus {
  ACTIVE
  WINNING
  EXPIRED
}

