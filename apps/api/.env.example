NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL="postgresql://surewina:surewina_password@127.0.0.1:55432/surewina_dev?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET="replace-with-a-secure-access-secret"
JWT_REFRESH_SECRET="replace-with-a-secure-refresh-secret"

OTP_TTL_SECONDS=300

LOG_LEVEL=info

ADMIN_SEED_EMAIL=admin@surewina.local
ADMIN_SEED_PASSWORD=AdminPass123!
ADMIN_SEED_FULL_NAME=Surewina Admin


# Financial providers (production gate requires live Paystack collection key).
# Do not enable live Paystack prize transfers without Phase 6E sign-off.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_TRANSFERS_ENABLED=false
PAYSTACK_TRANSFER_FEE_BUFFER_KOBO=100000

MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_CONTRACT_CODE=
MONNIFY_SOURCE_ACCOUNT_NUMBER=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_WEBHOOK_HASH=

PAYMENT_CALLBACK_BASE_URL=http://localhost:3000
PUBLIC_WEB_BASE_URL=http://localhost:3000
AGENT_WEB_BASE_URL=http://localhost:3001
REFUNDS_MODE=dev

TREASURY_BANK_REFERENCE=
TREASURY_BANK_CODE=
TREASURY_BANK_ACCOUNT_LAST4=
FINANCIAL_LEDGER_CUTOVER_AT=
# Witmango / CBA Fineract external wallets (read-only integration only)
# Populate with CBA-authorized environment credentials, never demo Postman values.
# Leave disabled until the external ledger/settlement reconciliation is agreed.
WITMANGO_ENABLED=false
WITMANGO_BASE_URL=
WITMANGO_TENANT_ID=
WITMANGO_USERNAME=
WITMANGO_PASSWORD=
WITMANGO_TIMEOUT_MS=10000
WITMANGO_PROVISIONING_ENABLED=false
WITMANGO_WITHDRAWAL_RESERVATIONS_ENABLED=false
WITMANGO_MONETARY_ENABLED=false
KYC_BANK_FINGERPRINT_KEY=
# AES-256-GCM key for verified payout destinations.
# Separate from KYC_BANK_FINGERPRINT_KEY.
PAYOUT_ACCOUNT_ENCRYPTION_KEY=
# Do not reuse the HMAC key as an encryption key.
# The encryption key is one random 32-byte value encoded as base64.
# Do not commit any actual key to the repository.
