{
  "name": "@surewina/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript types for Surewina platform",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@surewina/config": "workspace:*",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.0"
  }
}